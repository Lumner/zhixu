.probe { display:flex; flex-direction:column; width:100%; box-sizing:border-box; background:#ffffff; color:#1f2937; }
.top-reserved { display:block; flex-shrink:0; }
.probe-scroll { display:block; width:100%; box-sizing:border-box; }
.probe-content { display:block; padding:16px 16px 48px; box-sizing:border-box; }
.probe-title { display:block; font-size:24px; font-weight:700; line-height:1.6; }
.probe-text { display:block; font-size:18px; line-height:1.7; margin-top:12px; }
.probe-row { display:block; box-sizing:border-box; margin-top:12px; padding:16px; border:1px solid #475569; font-size:18px; line-height:1.6; }
