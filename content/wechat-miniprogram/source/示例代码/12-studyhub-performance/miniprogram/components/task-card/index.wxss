.card { box-sizing: border-box; margin: 20rpx 0; padding: 24rpx; background: #fff; border-radius: 20rpx; color: #1f2937; }
.card--done { background: #eaf5ee; }
.title { display: block; font-weight: 700; font-size: 30rpx; word-break: break-all; }
.card--done .title { text-decoration: line-through; }
.meta, .status { display: block; margin: 12rpx 0; font-size: 24rpx; color: #64748b; }
button { margin: 12rpx 0 0; font-size: 24rpx; }
.extra { margin-top: 12rpx; }
