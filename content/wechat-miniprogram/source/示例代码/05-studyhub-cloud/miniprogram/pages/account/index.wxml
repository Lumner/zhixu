<view class="page">
  <view class="panel">
    <text class="title">可信身份与环境</text>
    <text wx:if="{{status === 'loading'}}">正在验证……</text>
    <block wx:elif="{{status === 'ready'}}">
      <text class="muted">AppID：{{appId}}</text><text class="muted">用户核对标记：{{userTag}}</text>
      <text class="muted">标记只是方便人工区分测试用户，不是登录凭证。</text>
    </block>
    <text wx:else class="error">{{errorMessage}}</text>
    <button bindtap="refresh">重新验证身份</button>
  </view>
  <view class="panel">
    <button loading="{{pingBusy}}" disabled="{{pingBusy}}" bindtap="onPing">调用 helloCloud</button>
    <text class="muted spaced">{{pingMessage}}</text>
    <text class="muted spaced">本例不获取头像、昵称或手机号。身份识别与个人资料授权是不同能力。</text>
  </view>
</view>
