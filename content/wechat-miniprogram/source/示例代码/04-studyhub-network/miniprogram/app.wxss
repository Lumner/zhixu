page { background: #f4f7fb; color: #1f2937; font-family: sans-serif; font-size: 28rpx; line-height: 1.6; }
.page { max-width: 960rpx; margin: 0 auto; padding: 28rpx 24rpx 72rpx; }
.panel { margin-bottom: 24rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; }
.title { display: block; font-size: 38rpx; font-weight: 700; }
.section-title { display: block; font-size: 30rpx; font-weight: 700; margin: 12rpx 0; }
.muted { display: block; color: #64748b; font-size: 26rpx; }
.input, .textarea, .picker { box-sizing: border-box; width: 100%; margin: 12rpx 0; padding: 16rpx; border: 1px solid #cbd5e1; border-radius: 12rpx; background: #fff; }
.input { height: 88rpx; }
.textarea { min-height: 200rpx; }
.error { display: block; color: #b42318; margin: 16rpx 0; }
.actions { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.actions button { margin: 0 12rpx 12rpx 0; }
button { font-size: 28rpx; }
.spaced { margin-top: 20rpx; }
