page{background:#ffffff;color:#1f2937;}.privacy-page{box-sizing:border-box;width:100%;max-width:880px;margin:0 auto;padding:20px 16px 32px;padding-bottom:calc(32px + env(safe-area-inset-bottom));font-size:18px;line-height:1.7;}.privacy-title{display:block;font-size:24px;font-weight:700;}.privacy-warning{display:block;color:#b42318;margin:16px 0;}.privacy-section{margin:20px 0;}.privacy-heading{display:block;font-size:20px;font-weight:700;margin-top:16px;}.privacy-status{display:block;white-space:pre-wrap;word-break:break-all;margin:16px 0;}button{min-height:48px;height:auto;font-size:18px;white-space:normal;line-height:1.5;padding:12px;margin:12px 0;}
